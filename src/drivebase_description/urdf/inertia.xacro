<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box about its own center. -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(mass / 12.0) * (y*y + z*z)}"
        iyy="${(mass / 12.0) * (x*x + z*z)}"
        izz="${(mass / 12.0) * (x*x + y*y)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder, symmetry axis along local Z. Wheels are rotated into
       place by their joint, so the axle axis is Z here, not Y. -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${(mass / 12.0) * (3*radius*radius + length*length)}"
        iyy="${(mass / 12.0) * (3*radius*radius + length*length)}"
        izz="${(mass / 2.0) * radius * radius}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </xacro:macro>

  <!-- Near-massless sensor bodies. Real values are negligible next to the
       chassis, but zero-mass links break some physics engines. -->
  <xacro:macro name="sensor_inertia">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

</robot>
