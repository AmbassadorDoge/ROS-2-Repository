<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drivebase_localization</name>
  <version>0.1.0</version>
  <description>State estimation for the drivebase: EKF fusion of wheel odometry, IMU, and later GPS.</description>
  <maintainer email="bryanhsu0123@gmail.com">Robot Curiosity</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
